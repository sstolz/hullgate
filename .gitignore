
# cairn
# runtime credentials (agent login token, per-server SSH keys under ssh/, git credentials)
.cairn/auth/

# generated bootstrap, regenerated by cairn docker and cairn render-bootstrap (BR-032/BR-033); tracking it turns every regeneration into a tracked diff
/CAIRN.md

# ephemeral overlay scratch used by cairn docker, normally auto-cleaned at session exit
.cairn/.docker-stage/

# legacy role MCP profiles (.cairn/mcp/<role>.json), each carrying a bearer token
.cairn/mcp/

# MCP server config, carries auth tokens in request headers
/.mcp.json

# cairn docker session transcripts
.cairn/logs/

# cairn session state
.cairn/state/

# cairn docker share dir (host to container drag-and-drop bridge)
.cairn/share/

# hullgate (F-004)
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
/.env
/backups/
/.deployed-ref
/.deployed-ref.tmp
/.smoke/
/.env.pre-hullgate
/.env.pre-rebuild
# mounted secrets of the foundation (F-005), never versioned
/secrets/
/.ct-secrets-*/

# quality analysis (F-007)
/coverage.xml
/coverage.sha
/.coverage
.scannerwork/

# console (F-016): dependencies and build output, never committed
/web/node_modules/
/web/dist/
/.web-step-*/

# Public export only (F-022 D1(c)); private source stays tracked.
/.cairn/project-context.yaml
/.cairn/runs/
/.cairn/learnings/
/.cairn/workshop.git/
