# syntax=docker/dockerfile:1
#
# Project-specific Docker image for hullgate.
# Generated by cairn v0.57.0 on 2026-10-27 (no stack detected — empty scaffold, edit on first need).
#
# Layered on the resolved runtime's base image (cairn-claudecode:latest by
# default, cairn-vibe:latest when runtime.default: "mistral-vibe", etc.) —
# adds the tooling your project needs at runtime. The cairn docker wrapper
# detects this file and builds from it instead of the base image. The two
# ARGs below let the same Dockerfile.project work across runtimes: the
# wrapper passes --build-arg matching the runtime resolved per project-
# context.yaml runtime.default, so you don't need to edit the FROM line if
# you switch the project to a different runtime later.
#
# Edit freely. A session in the project container that misses a tool first
# constates whether it has a path to root in its own container (uid 0, or
# 'docker exec --user root' through the socket). With one, it installs the
# tool itself; without one, it hands you a one-line command to run. Either
# way, only a command that worked live and was then verified is added here
# (see ai-vademecum/missing-tool-handshake.md). This file serves all roles
# and all runtimes of the project: an install line must build on each.
# Re-running 'cairn docker' rebuilds; the layer cache keeps it fast.

ARG CAIRN_BASE_IMAGE=cairn-claudecode:latest
FROM ${CAIRN_BASE_IMAGE}
ARG CAIRN_CONTAINER_USER=claude

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
    && rm -rf /var/lib/apt/lists/*
# Codex CLI (operator decision 2026-11-14): the orchestrator delegates side
# tasks to it, run only in a throwaway container that mounts the task's
# worktree (never unsandboxed here: this container holds .cairn/auth and
# .mcp.json). Static musl binaries from the GitHub release; codex-code-mode-host
# is required by `codex exec`. Verified live as root in the toolbox image.
RUN set -e; v=rust-v0.169.0; a="$(uname -m)"; \
    for n in codex codex-code-mode-host; do \
        curl -fsSL "https://github.com/openai/codex/releases/download/$v/$n-$a-unknown-linux-musl.tar.gz" | tar -xz -C /tmp; \
        install -m 0755 "/tmp/$n-$a-unknown-linux-musl" "/usr/local/bin/$n"; \
        rm "/tmp/$n-$a-unknown-linux-musl"; \
    done; \
    codex --version
USER ${CAIRN_CONTAINER_USER}
