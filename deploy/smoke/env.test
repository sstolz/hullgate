# Test .env of `make prod-smoke` (session) — never used on the production server. No secret.
COMPOSE_PROJECT_NAME=hullgate-smoke
MCP_HOST=hullgate.smoke.invalid
TRAEFIK_NETWORK=hullgate-smoke-traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=smoke-acme
TRAEFIK_HTTPS_PORT=18443
ADMIN_LOCAL_PORT=24791
HULLGATE_VOLUME=hullgate-smoke_data
HULLGATE_IMAGE=hullgate:smoke
UPSTREAMS_NETWORK=hullgate-smoke_upstreams
# Fixed isolated subnet; trust only Traefik, never either probe client (BR-315).
TRAEFIK_SUBNET=172.30.247.0/24
TRAEFIK_ADDRESS=172.30.247.2
TRUSTED_PROXIES=172.30.247.2/32
PROBE_ADDRESS_A=172.30.247.10
PROBE_ADDRESS_B=172.30.247.11
