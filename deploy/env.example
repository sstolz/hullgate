# hullgate on the server — copy to /opt/hullgate/.env (not versioned) and fill in (runbook O5).
# No secret in this file: the foundation's secrets (F-005) are mounted files, named here.

# --- To fill in (values read at step O1 and chosen at step O2) ---
# Public name of the MCP gateway, served over TLS by Traefik (DNS record of step O2).
MCP_HOST=
# Traefik's docker network (`networks` key of an existing project in the directory of your existing compose projects).
TRAEFIK_NETWORK=
# Required for every deployment (BR-302), including the SSH-tunnel console. Read the network
# first: docs/guides/admin.md step P1. Prefer Traefik's own address (/32 IPv4 or /128 IPv6),
# not its subnet: a subnet also trusts its other containers. Host callers of the loopback admin port
# arrive from the network gateway; do not trust it. The public console requires Traefik's own address.
# Check forged X-Forwarded-For as described in docs/guides/admin.md step D3.
TRUSTED_PROXIES=
# Traefik's HTTPS entry point (label `...routers.<x>.entrypoints` of an existing project).
TRAEFIK_ENTRYPOINT=
# Traefik's ACME certificate resolver (label `...routers.<x>.tls.certresolver`).
TRAEFIK_CERTRESOLVER=

# --- Default values, to check ---
# Traefik's HTTPS port on the server (used by `make verify` through curl --resolve).
TRAEFIK_HTTPS_PORT=443
# Local port of the administration, published on the server's 127.0.0.1 only (SSH tunnel).
ADMIN_LOCAL_PORT=14791

# --- Mounted secrets (F-005, runbook keys-and-upstreams): files outside the repository, mode 0400, UID 10001 ---
# ES256 signing key of the OAuth access tokens (PEM) and TOTP secret of the authorization barrier (base32).
SIGNING_KEY_PATH=/opt/hullgate/secrets/signing_key
AUTHORIZE_TOTP_PATH=/opt/hullgate/secrets/authorize_totp
# F-006 (runbook keys-and-upstreams): connections encryption key (32 bytes in base64).
CONNECTIONS_KEY_PATH=/opt/hullgate/secrets/connections_key

# --- Do not change without a reason ---
# Database volume and tag of the image built on the server.
HULLGATE_VOLUME=hullgate_data
HULLGATE_IMAGE=hullgate:current

# F-008: MCP upstreams (deploy/upstreams.compose.yaml, runbook docs/guides/keys-and-upstreams.md).
# URL of the Gitea that gitea-mcp serves (one host per process); upstreams network, created by `make deploy`
# and joined by deploy/upstreams.compose.yaml (F-010: hullgate_upstreams, both files read
# this key).
GITEA_URL=https://git.example.org
UPSTREAMS_NETWORK=hullgate_upstreams

# Optional public console (BR-230). Leave empty for the SSH tunnel.
ADMIN_HOST=
# With ADMIN_HOST set, this must be exactly https://${ADMIN_HOST} (write the actual hostname).
ADMIN_URL=
# For sibling console/MCP names choose their parent domain BEFORE enrolling passkeys.
ADMIN_RP_ID=
