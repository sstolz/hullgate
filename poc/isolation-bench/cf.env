# Configuration unique de ContextForge pour les 16 tests (BR-011). Aucun secret ici.
# Les valeurs non listées sont les valeurs par défaut de l'image épinglée (v1.1.0).
HOST=0.0.0.0
PORT=4444
AUTH_REQUIRED=true
MCP_CLIENT_AUTH_ENABLED=true
EMAIL_AUTH_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=false
SSRF_ALLOW_LOCALHOST=true
SSRF_ALLOW_PRIVATE_NETWORKS=true
CACHE_TYPE=database
LOG_LEVEL=INFO
# Pas de sondage de santé ni d'actualisation en tâche de fond pendant la recette : toute entrée du journal
# amont doit venir d'un test (BR-002).
HEALTH_CHECK_INTERVAL=86400
GATEWAY_AUTO_REFRESH_INTERVAL=86400
